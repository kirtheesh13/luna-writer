# Luna Writer & Masterclass - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Application Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# MongoDB Configuration (Beanie ODM with PyMongo Async)
# Local instance or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net
# If MongoDB is not reachable locally, Luna Writer automatically runs in persistent embedded mode.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=luna_writer

# JWT & Password Security (python-jose & passlib)
JWT_SECRET_KEY=generate_or_paste_a_secure_jwt_secret_here

# Google Gemini AI Service
# Generates CEFR writing assessments, vocabulary suggestions, and story breakdown highlights
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-2.5-flash

# Upload Constraints
MAX_UPLOAD_SIZE_BYTES=5242880  # 5MB
ALLOWED_EXTENSIONS=.txt,.md,.docx,.json
